{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm --prefix yovexa-solutions run build",
  "outputDirectory": "yovexa-solutions/dist",
  "installCommand": "npm --prefix yovexa-solutions install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
